# Kopieren nach .env und ausfüllen. Die .env gehört nicht ins Git-Repo.

# Erzeugen mit: openssl rand -base64 64 | tr -d '\n'
JWT_KEY=

# Optional, aus der Mail der Deutschen Kreditwirtschaft
FINTS_PRODUCT_ID=

# Optional, für Benachrichtigungen über Home Assistant
# Adresse von Home Assistant, wie Zaster sie erreicht
HA_URL=http://homeassistant.local:8123
# Long-Lived Access Token (Home Assistant → Profil → Sicherheit)
HA_TOKEN=
# Adresse von Zaster, wie das Handy sie erreicht
ZASTER_URL=https://zaster.example.de

# Optional, tägliche Sicherung auf das NAS der FritzBox (in docker-compose.yml die fritzbox-Zeilen einkommentieren)
# Ordner im Container, mit dem Volume fritzbox: /backup. Leer = keine automatische Sicherung
BACKUP_DIR=
# Adresse der FritzBox, am besten die IP
FRITZ_HOST=192.168.178.1
# Ordner auf dem NAS unterhalb von FRITZ.NAS, muss es schon geben (z. B. USB-Stick-Name/Zaster)
FRITZ_FOLDER=Zaster
# FritzBox-Benutzer mit Zugang zu NAS-Inhalten (Lesen und Schreiben)
FRITZ_USER=
# Ohne Komma: das Passwort steht in einer Liste, die durch Kommas getrennt ist
FRITZ_PASSWORD=
